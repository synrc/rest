{application, rest,
 [{description, "Modern REST framework for Erlang"},
  {vsn, "2.0.0"},
  {registered, [rest_sup]},
  {mod, {rest_app, []}},
  {applications, [
      kernel,
      stdlib,
      cowboy,
      jsx
  ]},
  {env, [
      {port, 8005},
      {start_http, true}
  ]},
  {modules, []},
  {licenses, ["MIT"]},
  {links, []}
 ]}.
